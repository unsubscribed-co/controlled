<?xml version="1.0" encoding="utf-8"?>
<!-- 4x3 by default for the whole remote (~270dp); 4x2 shows the compact card (widget_small.xml); nothing updates on a timer (updatePeriodMillis 0): it redraws when the app learns something new. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_description"
    android:initialLayout="@layout/widget_small"
    android:minWidth="250dp" android:minHeight="110dp"
    android:minResizeWidth="250dp" android:minResizeHeight="110dp"
    android:previewLayout="@layout/widget_small"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="4" android:targetCellHeight="3"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen" />
