<?xml version="1.0" encoding="utf-8"?>
<!--
  The widget when it's short (4x2, under the small remote's ~270dp): what's on and Power, then volume, the mic and Play or
  pause as the one filled key, spread across the width (RemoteWidget.kt picks this or widget_remote.xml by size).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_bg" android:clipToOutline="true" android:gravity="center_vertical"
    android:orientation="vertical" android:padding="12dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical" android:orientation="horizontal">
        <!-- What's on: the app's own icon, or (now_tv) the TV symbol, tinted here so it follows light and dark. -->
        <ImageView android:id="@+id/now_icon" android:layout_width="32dp" android:layout_height="32dp" android:layout_marginEnd="12dp" android:scaleType="fitCenter" />
        <ImageView android:id="@+id/now_tv" android:layout_width="32dp" android:layout_height="32dp" android:layout_marginEnd="12dp" android:scaleType="center" android:src="@drawable/sym_tv" android:tint="@color/widget_fg" />
        <LinearLayout android:id="@+id/name" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:gravity="center_vertical" android:orientation="vertical">
            <TextView android:id="@+id/now_title" android:drawableTint="@color/widget_fg" android:drawablePadding="4dp" android:textColor="@color/widget_fg" android:textSize="16sp"
                android:layout_width="wrap_content" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" />
            <TextView android:id="@+id/now_sub" android:drawableTint="@color/widget_fg" android:drawablePadding="4dp" android:textColor="@color/widget_fg" android:alpha="0.7" android:textSize="13sp"
                android:layout_width="wrap_content" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" />
        </LinearLayout>
        <ImageView android:id="@+id/power" android:layout_width="48dp" android:layout_height="48dp"  android:background="@drawable/bar_key" android:padding="11dp" android:scaleType="fitCenter" android:src="@drawable/sym_power_settings_new" android:tint="@color/widget_accent" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp" android:orientation="horizontal">
        <FrameLayout android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"><ImageView android:id="@+id/volume_down" android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="center" android:background="@drawable/bar_key" android:padding="11dp" android:scaleType="fitCenter" android:src="@drawable/sym_volume_down" android:tint="@color/widget_fg" /></FrameLayout>
        <FrameLayout android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"><ImageView android:id="@+id/volume_up" android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="center" android:background="@drawable/bar_key" android:padding="11dp" android:scaleType="fitCenter" android:src="@drawable/sym_volume_up" android:tint="@color/widget_fg" /></FrameLayout>
        <FrameLayout android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"><ImageView android:id="@+id/mic" android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="center" android:background="@drawable/bar_key" android:padding="11dp" android:scaleType="fitCenter" android:src="@drawable/sym_mic" android:tint="@color/widget_fg" /></FrameLayout>
        <FrameLayout android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"><ImageView android:id="@+id/play_pause" android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="center" android:background="@drawable/bar_key_accent" android:padding="11dp" android:scaleType="fitCenter" android:src="@drawable/sym_play_pause" android:tint="@color/widget_on_accent" /></FrameLayout>
    </LinearLayout>
</LinearLayout>
