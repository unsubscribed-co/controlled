<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 17 (targetSdk 37): talking to the TV on the home network, asked at runtime (Permission.kt). -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
    <!-- SSDP discovery's multicast lock and finding the Wi-Fi network (Ssdp.kt). -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- The remote in the notification shade (RemoteBar.kt), and putting it back after a restart. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Turning the TV on over Bluetooth LE, as LG ThinQ does (BleWake.kt). -->
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />
    <!-- The phone as a Bluetooth keyboard and mouse for a PC (PcHid.kt). -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Turning the TV on with the phone's IR blaster, when it has one (IrWake.kt). -->
    <uses-permission android:name="android.permission.TRANSMIT_IR" />
    <uses-feature android:name="android.hardware.consumerir" android:required="false" />
    <!-- The mic opens Android's speech dialog (VoiceActivity.kt). -->
    <queries>
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
    </queries>

    <application
        android:name=".ControlledApp"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        tools:targetApi="33"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Controlled">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- "Play on TV": a link shared from any app (Share.kt). -->
            <intent-filter android:label="@string/share_label" android:icon="@drawable/sym_cast">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
        <!-- The widget's mic: Android's speech dialog over the home screen (VoiceActivity.kt). -->
        <activity
            android:name=".VoiceActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <receiver
            android:name=".RemoteBar$Boot"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
        <!-- The home screen widget (RemoteWidget.kt). -->
        <receiver
            android:name=".RemoteWidget"
            android:exported="false"
            android:label="@string/tile_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_remote_info" />
        </receiver>
        <!-- The Quick Settings tile that opens the remote (RemoteTile.kt). -->
        <service
            android:name=".RemoteTile"
            android:exported="true"
            android:icon="@drawable/sym_settings_remote"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
    </application>
</manifest>
