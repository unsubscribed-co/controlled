<?xml version="1.0" encoding="utf-8"?>
<!-- Controlled for PC's Store package. Identity values come from Partner Center (product 9N08NXM529FH); the build
     script (pc/msix/pack.ps1) sets the Version and copies the exe next to this file. -->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:desktop2="http://schemas.microsoft.com/appx/manifest/desktop/windows10/2"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap desktop desktop2 rescap">
  <Identity Name="Unsubscribed.ControlledforPC" Publisher="CN=34C2F180-0655-4989-B274-01F88A70164A" Version="0.1.0.0" ProcessorArchitecture="x64" />
  <Properties>
    <DisplayName>Controlled for PC</DisplayName>
    <PublisherDisplayName>Unsubscribed!</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>
  <Resources>
    <Resource Language="en-us" />
    <Resource Language="es-419" />
  </Resources>
  <Applications>
    <Application Id="ControlledPc" Executable="controlled-pc.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements DisplayName="Controlled for PC" Description="Smooth mode for the Controlled phone app: your phone as this PC's mouse and keyboard over Wi-Fi."
        BackgroundColor="transparent" Square150x150Logo="Assets\Square150x150Logo.png" Square44x44Logo="Assets\Square44x44Logo.png" />
      <Extensions>
        <!-- Starts with Windows, in the background; the person can turn it off in Settings > Apps > Startup. -->
        <desktop:Extension Category="windows.startupTask" Executable="controlled-pc.exe" EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask TaskId="ControlledPcStartup" Enabled="true" DisplayName="Controlled for PC" />
        </desktop:Extension>
      </Extensions>
    </Application>
  </Applications>
  <!-- No firewall rules: the phone meets this PC over Bluetooth and this PC dials it, so nothing comes in unasked. -->
  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
